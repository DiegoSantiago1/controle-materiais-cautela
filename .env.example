# Copie este arquivo para .env e defina uma senha própria.
# O .env nunca é commitado (veja .gitignore).

# Banco deste projeto, dentro do container PostgreSQL do Projeto 1.
# 127.0.0.1 e não "localhost": no Windows, localhost resolve primeiro para o IPv6 ::1,
# mas o container publica a porta só em 127.0.0.1 (IPv4). Com localhost cada conexão
# esperava o timeout do ::1 antes de tentar o IPv4 (medido: 5,09 s contra 0,02 s).
ALMOX_DB_HOST=127.0.0.1
ALMOX_DB_PORT=5432
ALMOX_DB_NAME=almoxarifado
# Banco dos testes automatizados: é APAGADO e recriado a cada execução do pytest.
# Precisa ser diferente de ALMOX_DB_NAME (a configuração recusa se forem iguais).
ALMOX_DB_NAME_TESTE=almoxarifado_teste
ALMOX_DB_USER=almox
ALMOX_DB_PASSWORD=troque_esta_senha

# Usuário SOMENTE LEITURA para o Power BI (vê os schemas bi, analise e dq; não vê core
# nem staging). Criado pelo bootstrap como membro do grupo almox_leitura.
ALMOX_BI_USER=almox_bi
ALMOX_BI_PASSWORD=troque_esta_outra_senha

# Container e superusuário usados só pelo "python -m almox.bootstrap" (via docker exec,
# sem senha: dentro do container o psql conecta pelo socket local).
ALMOX_DOCKER_CONTAINER=honda-vendas-db
ALMOX_DOCKER_SUPERUSER=honda

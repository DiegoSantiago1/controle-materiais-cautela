	/// Ordem da situação: o mais grave primeiro.
	column gravidade = SWITCH ( fato_estoque_atual[situacao], "SEM_ESTOQUE", 1, "CRITICO", 2, "ABAIXO_DO_MINIMO", 3, 4 )
		dataType: int64
		isHidden
		lineageTag: 57930e6c-e470-5a95-a534-7c9065c4a7ef
		summarizeBy: none

	/// Situação escrita para gente ler.
	column situacao_texto = SWITCH ( fato_estoque_atual[situacao], "SEM_ESTOQUE", "Sem estoque", "CRITICO", "Crítico", "ABAIXO_DO_MINIMO", "Abaixo do mínimo", "Normal" )
		dataType: string
		lineageTag: e4035655-f40c-58df-8c62-dc84c464f817
		summarizeBy: none
		sortByColumn: gravidade


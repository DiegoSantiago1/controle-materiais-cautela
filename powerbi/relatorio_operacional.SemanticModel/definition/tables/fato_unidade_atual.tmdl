	/// Situação da unidade escrita para gente ler.
	column situacao_texto = SWITCH ( fato_unidade_atual[status], "DISPONIVEL", "Disponível", "CAUTELADA", "Em posse", "EM_MANUTENCAO", "Em manutenção", "BAIXA_PENDENTE", "Baixa pendente", "BAIXADA", "Baixada", "NAO_LOCALIZADA", "Não localizada", "AGUARDANDO_TOMBAMENTO", "Aguardando tombamento", fato_unidade_atual[status] )
		dataType: string
		lineageTag: d9efd27c-c94e-5aa7-8cbb-93272a797685
		summarizeBy: none


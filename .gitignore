# Contexto pessoal e de carreira (não vai para o GitHub)
CLAUDE.md

# Segredos e ambiente
.env
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Dados brutos e reais: nunca versionar (confidencialidade e LGPD)
data/raw/
original/
# Dados sintéticos: reproduzíveis pelo gerador, não versionados. O manifesto (com os
# hashes de cada arquivo) é versionado, para qualquer pessoa conferir a reprodução.
data/gerado/*
!data/gerado/manifesto.json
# Documentos de referência (ex.: PDF de carga real) nunca entram, mesmo fora de data/raw/
*.pdf

# Notebooks e ferramentas
.ipynb_checkpoints/
node_modules/
.DS_Store

# Demo estática (gerada por demo/exportar_dados.py e demo/build.mjs)
demo/dados-demo.json
demo/dist/
